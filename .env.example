# Copy to .env.local and adjust. Restart `pnpm dev` after changes.
# See docs/LOCAL.md for mock vs real backend modes.
# Public deploy (Vercel): see docs/DEPLOY-CHEAP.md

# Real API base URL (ky client). Used when mocks are off.
# Local: http://localhost:8080
# Production (Vercel): https://your-api.up.railway.app  (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Mock backend (MSW):
#   true  — always use mocks
#   false — call real NEXT_PUBLIC_API_URL (requires busnau-api running)
#   omit  — in development, mocks ON by default; set false for real API
# Vercel production: must be false
NEXT_PUBLIC_USE_MOCKS=true
